{
  "manifest_version": 3,
  "name": "Bookmark Hamster",
  "author": "Albert Kalchmair",
  "version": "2.0.0",
  "description": "__MSG_extension_description__",
  "homepage_url": "https://github.com/houmain/hamster",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "hamster@houmain",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "bookmarksInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "tabs",
    "bookmarks",
    "menus",
    "notifications",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon.svg",
    "24": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg",
    "256": "icons/icon.svg",
    "512": "icons/icon.svg",
    "1024": "icons/icon.svg"
  },
  "action": {
    "default_title": "Bookmark Hamster",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "BrowserApi.js",
      "Utils.js",
      "background/NativeClient.js",
      "background/Backend.js",
      "background/BookmarkLibrary.js",
      "background/background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "omnibox": {
    "keyword": "h"
  }
}
