{
  "manifest_version": 3,
  "name": "Bookmark Hamster",
  "author": "Albert Kalchmair",
  "version": "2.0.0",
  "description": "__MSG_extension_description__",
  "homepage_url": "https://github.com/houmain/hamster",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "tabs",
    "bookmarks",
    "contextMenus",
    "notifications",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon.svg",
    "24": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg",
    "256": "icons/icon.svg",
    "512": "icons/icon.svg",
    "1024": "icons/icon.svg"
  },
  "action": {
    "default_title": "Bookmark Hamster",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "omnibox": {
    "keyword": "h"
  }
}
